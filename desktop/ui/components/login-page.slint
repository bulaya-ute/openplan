import { Theme } from "../theme.slint";
import { StyledInput } from "styled-input.slint";

export component LoginPage inherits Rectangle {
    background: Theme.bg-secondary;

    in-out property <string> server-url: "http://localhost:5000/api/v1";
    in-out property <string> email;
    in-out property <string> password;
    in property  <string>    error: "";
    in property  <bool>      loading: false;

    callback submit(string, string, string); // server-url, email, password

    VerticalLayout {
        alignment: center;

        Rectangle {
            height: card.preferred-height + 64px;
            HorizontalLayout {
                alignment: center;
                card := VerticalLayout {
                    width: 360px;
                    spacing: 20px;
                    padding: 32px;

                    // Header
                    VerticalLayout {
                        spacing: 4px;

                        // Logo mark + wordmark
                        HorizontalLayout {
                            spacing: 10px;
                            alignment: start;

                            // Two-pill logo (offset staircase)
                            Rectangle {
                                width: 32px;
                                height: 32px;
                                // Top-left pill (dark blue)
                                Rectangle {
                                    x: 0px; y: 4px;
                                    width: 18px; height: 8px;
                                    border-radius: 4px;
                                    background: #1d4ed8;
                                }
                                // Bottom-right pill (light blue)
                                Rectangle {
                                    x: 12px; y: 18px;
                                    width: 18px; height: 8px;
                                    border-radius: 4px;
                                    background: #60a5fa;
                                }
                            }

                            Text {
                                text: "OpenPlan";
                                font-size: 22px;
                                font-weight: 700;
                                color: Theme.accent;
                                vertical-alignment: center;
                            }
                        }

                        Text {
                            text: "Sign in to your workspace";
                            font-size: 13px;
                            color: Theme.text-secondary;
                        }
                    }

                    // Card body
                    Rectangle {
                        background: Theme.bg-card;
                        border-radius: Theme.radius-lg;
                        border-width: 1px;
                        border-color: Theme.border;
                        drop-shadow-blur: 12px;
                        drop-shadow-color: #00000018;
                        drop-shadow-offset-y: 2px;

                        VerticalLayout {
                            padding: 24px;
                            spacing: 16px;

                            // Server URL
                            VerticalLayout {
                                spacing: 6px;
                                Text {
                                    text: "Server URL";
                                    font-size: 12px;
                                    font-weight: 600;
                                    color: Theme.text-secondary;
                                }
                                StyledInput {
                                    text <=> root.server-url;
                                    placeholder-text: "http://localhost:5000/api/v1";
                                }
                            }

                            // Email
                            VerticalLayout {
                                spacing: 6px;
                                Text {
                                    text: "Email";
                                    font-size: 12px;
                                    font-weight: 600;
                                    color: Theme.text-secondary;
                                }
                                StyledInput {
                                    text <=> root.email;
                                    placeholder-text: "you@example.com";
                                }
                            }

                            // Password
                            VerticalLayout {
                                spacing: 6px;
                                Text {
                                    text: "Password";
                                    font-size: 12px;
                                    font-weight: 600;
                                    color: Theme.text-secondary;
                                }
                                StyledInput {
                                    text <=> root.password;
                                    placeholder-text: "••••••••";
                                    input-type: InputType.password;
                                    accepted => {
                                        if (!root.loading) {
                                            root.submit(root.server-url, root.email, root.password);
                                        }
                                    }
                                }
                            }

                            // Error
                            if root.error != "": Text {
                                text: root.error;
                                font-size: 12px;
                                color: #ef4444;
                                wrap: word-wrap;
                            }

                            // Submit button
                            Rectangle {
                                height: 38px;
                                border-radius: Theme.radius-md;
                                background: root.loading ? Theme.accent-hover : Theme.accent;
                                animate background { duration: 120ms; }

                                btn-ta := TouchArea {
                                    enabled: !root.loading;
                                    clicked => {
                                        root.submit(root.server-url, root.email, root.password);
                                    }
                                }

                                Text {
                                    text: root.loading ? "Signing in…" : "Sign in";
                                    color: Theme.text-on-accent;
                                    font-size: 13px;
                                    font-weight: 600;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
