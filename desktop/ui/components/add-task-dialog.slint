import { LineEdit, TextEdit, ComboBox } from "std-widgets.slint";
import { Theme } from "../theme.slint";

export component AddTaskDialog inherits Rectangle {
    background: #00000040;

    in property  <string> project-id: "";
    in property  <string> parent-id:  "";
    in property  <bool>   saving: false;
    in property  <string> save-error: "";

    callback close();
    callback submit(string, string, string, string, string, string, string, string);
    // title, description, project-id, parent-id, priority, task-type, start-at, due-at

    backdrop-ta := TouchArea { clicked => { root.close(); } }

    HorizontalLayout {
        alignment: center;
        VerticalLayout {
            alignment: center;

            panel := Rectangle {
                width: 480px;
                background: Theme.bg;
                border-radius: Theme.radius-lg;
                border-width: 1px;
                border-color: Theme.border;
                drop-shadow-blur: 24px;
                drop-shadow-color: #00000030;
                drop-shadow-offset-y: 8px;
                clip: true;

                inner-ta := TouchArea { }

                VerticalLayout {
                    padding: 24px;
                    spacing: 16px;

                    // Header
                    HorizontalLayout {
                        Text {
                            text: "Add task";
                            font-size: 16px;
                            font-weight: 700;
                            color: Theme.text;
                            horizontal-stretch: 1;
                        }
                        close-btn := TouchArea {
                            width: 28px;
                            height: 28px;
                            clicked => { root.close(); }
                            Rectangle {
                                border-radius: 6px;
                                background: close-btn.has-hover ? Theme.bg-hover : transparent;
                                Text { text: "✕"; font-size: 13px; color: Theme.text-secondary;
                                    horizontal-alignment: center; vertical-alignment: center; }
                            }
                        }
                    }

                    Rectangle { height: 1px; background: Theme.border; }

                    // Title
                    VerticalLayout {
                        spacing: 6px;
                        Text { text: "Title *"; font-size: 11px; font-weight: 600; color: Theme.text-muted; }
                        title-edit := LineEdit {
                            placeholder-text: "Task title";
                        }
                    }

                    // Description
                    VerticalLayout {
                        spacing: 6px;
                        Text { text: "Description"; font-size: 11px; font-weight: 600; color: Theme.text-muted; }
                        desc-edit := TextEdit {
                            preferred-height: 60px;
                        }
                    }

                    // Priority / Type row
                    HorizontalLayout {
                        spacing: 12px;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 6px;
                            Text { text: "Priority"; font-size: 11px; font-weight: 600; color: Theme.text-muted; }
                            pri-combo := ComboBox {
                                model: ["P4", "P3", "P2", "P1"];
                                current-value: "P4";
                            }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 6px;
                            Text { text: "Type"; font-size: 11px; font-weight: 600; color: Theme.text-muted; }
                            type-combo := ComboBox {
                                model: ["Sequential", "Parallel"];
                                current-value: "Sequential";
                            }
                        }
                    }

                    // Start / Due row
                    HorizontalLayout {
                        spacing: 12px;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 6px;
                            Text { text: "Start"; font-size: 11px; font-weight: 600; color: Theme.text-muted; }
                            start-edit := LineEdit { placeholder-text: "YYYY-MM-DDTHH:MM"; }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 6px;
                            Text { text: "Due"; font-size: 11px; font-weight: 600; color: Theme.text-muted; }
                            due-edit := LineEdit { placeholder-text: "YYYY-MM-DDTHH:MM"; }
                        }
                    }

                    if root.save-error != "": Text {
                        text: root.save-error;
                        font-size: 12px;
                        color: #ef4444;
                        wrap: word-wrap;
                    }

                    // Footer
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: end;

                        cancel-btn := Rectangle {
                            height: 34px; width: 80px;
                            border-radius: Theme.radius-md;
                            border-width: 1px; border-color: Theme.border;
                            background: c-ta.has-hover ? Theme.bg-hover : Theme.bg;
                            animate background { duration: 80ms; }
                            c-ta := TouchArea { clicked => { root.close(); } }
                            Text { text: "Cancel"; font-size: 13px; color: Theme.text;
                                horizontal-alignment: center; vertical-alignment: center; }
                        }

                        submit-btn := Rectangle {
                            height: 34px; width: 100px;
                            border-radius: Theme.radius-md;
                            background: s-ta.has-hover && !root.saving
                                ? Theme.accent-hover : Theme.accent;
                            animate background { duration: 80ms; }
                            s-ta := TouchArea {
                                enabled: !root.saving;
                                clicked => {
                                    root.submit(
                                        title-edit.text,
                                        desc-edit.text,
                                        root.project-id,
                                        root.parent-id,
                                        pri-combo.current-value,
                                        type-combo.current-value,
                                        start-edit.text,
                                        due-edit.text,
                                    );
                                }
                            }
                            Text {
                                text: root.saving ? "Adding…" : "Add task";
                                font-size: 13px; font-weight: 600;
                                color: Theme.text-on-accent;
                                horizontal-alignment: center; vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }
    }
}
