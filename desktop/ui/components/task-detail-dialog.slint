import { LineEdit, TextEdit, Button, ComboBox } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { TaskData } from "../types.slint";

export component TaskDetailDialog inherits Rectangle {
    // Semi-transparent backdrop
    background: #00000040;

    in property  <TaskData> task;
    out property <string>   edit-title;
    out property <string>   edit-description;
    out property <string>   edit-priority;
    out property <string>   edit-status;
    out property <string>   edit-task-type;
    out property <string>   edit-start-at;
    out property <string>   edit-due-at;
    in property  <bool>     saving: false;
    in property  <string>   save-error: "";

    callback close();
    callback save(string, string, string, string, string, string, string);
    // title, description, priority, status, task-type, start-at, due-at

    // Populate edit fields whenever task changes
    init => {
        edit-title       = root.task.title;
        edit-description = root.task.description;
        edit-priority    = root.task.priority;
        edit-status      = root.task.status;
        edit-task-type   = root.task.task-type;
        edit-start-at    = root.task.start-at;
        edit-due-at      = root.task.due-at;
    }

    // Click backdrop to close
    backdrop-ta := TouchArea {
        clicked => { root.close(); }
    }

    // Centered panel
    HorizontalLayout {
        alignment: center;
        VerticalLayout {
            alignment: center;

            panel := Rectangle {
                width: 520px;
                background: Theme.bg;
                border-radius: Theme.radius-lg;
                border-width: 1px;
                border-color: Theme.border;
                drop-shadow-blur: 24px;
                drop-shadow-color: #00000030;
                drop-shadow-offset-y: 8px;
                clip: true;

                // Consume clicks so backdrop-ta doesn't fire
                inner-ta := TouchArea { }

                VerticalLayout {
                    padding: 24px;
                    spacing: 16px;

                    // Header row
                    HorizontalLayout {
                        spacing: 12px;
                        alignment: start;

                        // Priority badge
                        Rectangle {
                            width: 28px;
                            height: 28px;
                            border-radius: 6px;
                            background:
                                root.task.priority == "P1" ? Theme.p1 :
                                root.task.priority == "P2" ? Theme.p2 :
                                root.task.priority == "P3" ? Theme.p3 : Theme.p4;
                            Text {
                                text: root.task.priority;
                                font-size: 9px;
                                font-weight: 700;
                                color: Theme.text-on-accent;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        Text {
                            text: "Task details";
                            font-size: 16px;
                            font-weight: 700;
                            color: Theme.text;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }

                        // Close button
                        close-btn := TouchArea {
                            width: 28px;
                            height: 28px;
                            clicked => { root.close(); }
                            Rectangle {
                                border-radius: 6px;
                                background: close-btn.has-hover ? Theme.bg-hover : transparent;
                                Text {
                                    text: "✕";
                                    font-size: 13px;
                                    color: Theme.text-secondary;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    // Divider
                    Rectangle { height: 1px; background: Theme.border; }

                    // Title
                    VerticalLayout {
                        spacing: 6px;
                        Text { text: "Title"; font-size: 11px; font-weight: 600; color: Theme.text-muted; }
                        title-edit := LineEdit {
                            text: root.task.title;
                            edited => { root.edit-title = self.text; }
                        }
                    }

                    // Description
                    VerticalLayout {
                        spacing: 6px;
                        Text { text: "Description"; font-size: 11px; font-weight: 600; color: Theme.text-muted; }
                        desc-edit := TextEdit {
                            text: root.task.description;
                            preferred-height: 80px;
                            edited => { root.edit-description = self.text; }
                        }
                    }

                    // Row: Priority / Status / Task type
                    HorizontalLayout {
                        spacing: 12px;

                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 6px;
                            Text { text: "Priority"; font-size: 11px; font-weight: 600; color: Theme.text-muted; }
                            pri-combo := ComboBox {
                                model: ["P1", "P2", "P3", "P4"];
                                current-value: root.task.priority;
                                selected => { root.edit-priority = self.current-value; }
                            }
                        }

                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 6px;
                            Text { text: "Status"; font-size: 11px; font-weight: 600; color: Theme.text-muted; }
                            status-combo := ComboBox {
                                model: ["Scheduled", "Active", "Completed", "Cancelled"];
                                current-value: root.task.status;
                                selected => { root.edit-status = self.current-value; }
                            }
                        }

                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 6px;
                            Text { text: "Type"; font-size: 11px; font-weight: 600; color: Theme.text-muted; }
                            type-combo := ComboBox {
                                model: ["Sequential", "Parallel"];
                                current-value: root.task.task-type;
                                selected => { root.edit-task-type = self.current-value; }
                            }
                        }
                    }

                    // Row: Start / Due
                    HorizontalLayout {
                        spacing: 12px;

                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 6px;
                            Text { text: "Start"; font-size: 11px; font-weight: 600; color: Theme.text-muted; }
                            start-edit := LineEdit {
                                text: root.task.start-at;
                                placeholder-text: "YYYY-MM-DDTHH:MM";
                                edited => { root.edit-start-at = self.text; }
                            }
                        }

                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 6px;
                            Text { text: "Due"; font-size: 11px; font-weight: 600; color: Theme.text-muted; }
                            due-edit := LineEdit {
                                text: root.task.due-at;
                                placeholder-text: "YYYY-MM-DDTHH:MM";
                                edited => { root.edit-due-at = self.text; }
                            }
                        }
                    }

                    // Error
                    if root.save-error != "": Text {
                        text: root.save-error;
                        font-size: 12px;
                        color: #ef4444;
                        wrap: word-wrap;
                    }

                    // Footer buttons
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: end;

                        // Cancel
                        cancel-btn := Rectangle {
                            height: 34px;
                            width: 80px;
                            border-radius: Theme.radius-md;
                            border-width: 1px;
                            border-color: Theme.border;
                            background: cancel-ta.has-hover ? Theme.bg-hover : Theme.bg;
                            animate background { duration: 80ms; }
                            cancel-ta := TouchArea {
                                clicked => { root.close(); }
                            }
                            Text {
                                text: "Cancel";
                                font-size: 13px;
                                color: Theme.text;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        // Save
                        save-btn := Rectangle {
                            height: 34px;
                            width: 80px;
                            border-radius: Theme.radius-md;
                            background: save-ta.has-hover && !root.saving
                                ? Theme.accent-hover : Theme.accent;
                            animate background { duration: 80ms; }
                            save-ta := TouchArea {
                                enabled: !root.saving;
                                clicked => {
                                    root.save(
                                        root.edit-title,
                                        root.edit-description,
                                        root.edit-priority,
                                        root.edit-status,
                                        root.edit-task-type,
                                        root.edit-start-at,
                                        root.edit-due-at,
                                    );
                                }
                            }
                            Text {
                                text: root.saving ? "Saving…" : "Save";
                                font-size: 13px;
                                font-weight: 600;
                                color: Theme.text-on-accent;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }
    }
}
